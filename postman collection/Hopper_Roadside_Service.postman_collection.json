{
  "info": {
    "_postman_id": "hopper-service-api-collection",
    "name": "Hopper Roadside - Service API",
    "description": "Service management endpoints for Hopper Roadside application",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "hopper-roadside"
  },
  "item": [
    {
      "name": "Create Service",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "name",
              "value": "Emergency Towing",
              "type": "text"
            },
            {
              "key": "description",
              "value": "24/7 emergency towing service",
              "type": "text"
            },
            {
              "key": "price",
              "value": "100",
              "type": "text"
            },
            {
              "key": "milageFee",
              "value": "5",
              "type": "text"
            },
            {
              "key": "totalFee",
              "value": "10",
              "type": "text"
            },
            {
              "key": "category",
              "value": "6507f1d4c5a3e2001f8b4567",
              "type": "text"
            },
            {
              "key": "icon",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/service/create",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "service", "create"]
        },
        "description": "Create a new service with icon upload (Admin only)"
      },
      "response": []
    },
    {
      "name": "Get Services by Category",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/service/:categoryId?page=1&limit=10",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "service", ":categoryId"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ],
          "variable": [
            {
              "key": "categoryId",
              "value": "6507f1d4c5a3e2001f8b4567"
            }
          ]
        },
        "description": "Get all services in a specific category (All authenticated users)"
      },
      "response": []
    },
    {
