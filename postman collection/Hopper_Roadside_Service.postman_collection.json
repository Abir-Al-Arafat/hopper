        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/service/delete/:serviceId",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "service", "delete", ":serviceId"],
          "variable": [
            {
              "key": "serviceId",
              "value": "6507f1d4c5a3e2001f8b4568"
            }
          ]
        },
        "description": "Delete a service (Admin only)"
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
