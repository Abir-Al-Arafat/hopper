      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/service/confirm_service/:serviceId",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "service", "confirm_service", ":serviceId"],
          "variable": [
            {
              "key": "serviceId",
              "value": "6507f1d4c5a3e2001f8b4568"
            }
          ]
        },
        "description": "Get service details for confirmation (Customer only)"
      },
      "response": []
    },
    {
