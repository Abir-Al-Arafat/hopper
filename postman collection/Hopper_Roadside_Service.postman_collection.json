        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "name",
              "value": "Premium Towing Service",
              "type": "text"
            },
            {
              "key": "description",
              "value": "Premium 24/7 towing with express service",
              "type": "text"
            },
            {
              "key": "price",
              "value": "150",
              "type": "text"
            },
            {
              "key": "milageFee",
              "value": "7",
              "type": "text"
            },
            {
              "key": "totalFee",
              "value": "15",
              "type": "text"
            },
            {
              "key": "icon",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/service/edit/:serviceId",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "service", "edit", ":serviceId"],
          "variable": [
