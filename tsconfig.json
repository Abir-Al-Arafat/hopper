{
  "compilerOptions": {
    /* Language and Environment */
    "resolveJsonModule": true,
    "target": "ES2016",
    /* Modules */
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}